#!/bin/zsh
# MemGuard - reduces risk from memory pressure; cannot prevent every panic.
# Watches free memory and swap files. Warns early. On critical pressure it
# terminates ONLY processes matching the configured target patterns.
# No dependencies beyond macOS itself.
emulate -L zsh
setopt no_unset pipe_fail

VERSION="1.1.0"
SYS_DIR="/Library/Application Support/MemGuard"
USER_DIR="$HOME/Library/Application Support/MemGuard"
LOG_DIR="${MEMGUARD_LOG_DIR:-$HOME/Library/Logs/MemGuard}"
LOG="$LOG_DIR/memguard.log"
PAUSE_FILE="${MEMGUARD_PAUSE_FILE:-$HOME/.memguard-off}"

# ---------- config ----------
cfg_file() {
  if [[ -n "${MEMGUARD_CONFIG:-}" ]]; then print -r -- "$MEMGUARD_CONFIG"; return; fi
  for f in "$USER_DIR/config.json" "$SYS_DIR/config.json"; do
    [[ -r "$f" ]] && { print -r -- "$f"; return; }
  done
}
cfg() { # cfg <key> <default>
  local f; f=$(cfg_file)
  local v=""
  [[ -n "$f" ]] && v=$(plutil -extract "$1" raw -o - "$f" 2>/dev/null)
  print -r -- "${v:-$2}"
}
cfg_targets() {
  local f i=0 v; f=$(cfg_file); [[ -z "$f" ]] && return
  while v=$(plutil -extract "targets.$i" raw -o - "$f" 2>/dev/null); do
    [[ -n "$v" ]] && print -r -- "${v//\~/$HOME}"
    (( i++ ))
  done
}
load_cfg() {
  local f; f=$(cfg_file)
  if [[ -n "$f" ]] && ! plutil -convert xml1 -o /dev/null "$f"; then
    print -u2 'Invalid configuration: monitoring stopped'; return 1
  fi
  if [[ -n "$f" ]]; then
    local key expected count i
    for key in interval warn_free_percent critical_free_percent warn_swapfiles critical_swapfiles warn_repeat_seconds terminate_grace_seconds language notifications targets; do
      expected=integer
      [[ "$key" == language ]] && expected=string
      [[ "$key" == notifications ]] && expected=bool
      [[ "$key" == targets ]] && expected=array
      [[ "$(plutil -type "$key" "$f" 2>/dev/null)" == "$expected" ]] || { print -u2 "Invalid configuration type: $key"; return 1; }
    done
    count=$(plutil -extract targets raw -o - "$f")
    (( count <= 50 )) || { print -u2 'Too many targets'; return 1; }
    for (( i=0; i<count; i++ )); do
      [[ "$(plutil -type "targets.$i" "$f" 2>/dev/null)" == string ]] || { print -u2 'Target must be a string'; return 1; }
    done
  fi
  INTERVAL=$(cfg interval 10)
  WARN_FREE=$(cfg warn_free_percent 20)
  CRIT_FREE=$(cfg critical_free_percent 10)
  WARN_SWAP=$(cfg warn_swapfiles 20)
  CRIT_SWAP=$(cfg critical_swapfiles 40)
  WARN_REPEAT=$(cfg warn_repeat_seconds 600)
  GRACE=$(cfg terminate_grace_seconds 8)
  LANG_UI=$(cfg language en)
  NOTIFY=$(cfg notifications true)
  if [[ -n "${MEMGUARD_TARGETS:-}" ]]; then TARGETS=(${(s:|:)MEMGUARD_TARGETS}); else TARGETS=(${(f)"$(cfg_targets)"}); fi
  local val
  for val in "$INTERVAL" "$WARN_FREE" "$CRIT_FREE" "$WARN_SWAP" "$CRIT_SWAP" "$WARN_REPEAT" "$GRACE"; do
    [[ "$val" == <-> && ${#val} -le 6 ]] || { print -u2 'Configuration requires bounded non-negative integers'; return 1; }
  done
  (( INTERVAL >= 2 && INTERVAL <= 300 && CRIT_FREE < WARN_FREE && WARN_FREE <= 100 && WARN_SWAP >= 1 && WARN_SWAP < CRIT_SWAP && CRIT_SWAP <= 1000 && WARN_REPEAT >= 30 && WARN_REPEAT <= 86400 && GRACE >= 1 && GRACE <= 60 )) || { print -u2 'Configuration thresholds out of range'; return 1; }
  [[ "$NOTIFY" == true || "$NOTIFY" == false ]] || return 1
  [[ "$LANG_UI" == en || "$LANG_UI" == de ]] || return 1
  for val in "${TARGETS[@]}"; do
    [[ ${#val} -ge 4 && ${#val} -le 300 && "$val" != *[[:cntrl:]]* && "$val" != [[:space:]]* && "$val" != *[[:space:]] ]] || { print -u2 'Target must contain 4-300 characters, no controls or surrounding whitespace'; return 1; }
  done
}

# ---------- helpers ----------
ts() { date "+%Y-%m-%d %H:%M:%S"; }
log() {
  mkdir -p "$LOG_DIR"
  local size=0
  [[ -f "$LOG" ]] && size=$(stat -f %z "$LOG" 2>/dev/null)
  [[ "$size" == <-> ]] && (( size > 5242880 )) && mv -f "$LOG" "$LOG.1"
  print -r -- "$(ts) $*" >> "$LOG"
}
t() { # t <en> <de>
  [[ "$LANG_UI" == de ]] && print -r -- "$2" || print -r -- "$1"
}
notify() {
  [[ "$NOTIFY" == true ]] || return 0
  osascript - "$1" "$2" <<'APPLESCRIPT' >/dev/null 2>&1
on run argv
  display notification (item 2 of argv) with title (item 1 of argv) sound name "Basso"
end run
APPLESCRIPT
}
measure() {
  if [[ -n "${MEMGUARD_FAKE_FREE:-}" ]]; then FREE=$MEMGUARD_FAKE_FREE
  else FREE=$(sysctl -n kern.memorystatus_level 2>/dev/null); fi
  [[ "$FREE" == <-> ]] && (( FREE <= 100 )) || { FREE=unknown; return 1; }
  [[ -d /System/Volumes/VM && -r /System/Volumes/VM ]] || { SWAPFILES=unknown; return 1; }
  local files=(/System/Volumes/VM/swapfile*(N.))
  SWAPFILES=${#files}
}
top_apps() { # biggest apps by resident memory, grouped by .app bundle
  ps -Axo rss=,comm= | awk '
    { rss=$1; $1=""; sub(/^ /,""); n=$0
      if (match(n,/\/[^\/]+\.app\//)) { n=substr(n,RSTART+1,RLENGTH-6) } else { k=split(n,a,"/"); n=a[k] }
      s[n]+=rss }
    END { for (k in s) printf "%.1f\t%s\n", s[k]/1048576, k }' | sort -rn | head -${1:-3} |
    awk -F'\t' '{printf "%s%s %s GB", (NR>1?", ":""), $2, $1}'
}
find_targets() { # prints "pid<TAB>args" for matching processes
  (( ${#TARGETS} )) || return 0
  local self=$$ pat
  ps -U "$(id -u)" -o pid=,args= | while read -r pid args; do
    [[ "$pid" == "$self" || "$pid" == "$PPID" || "$pid" -le 1 || "$args" == *memguard* ]] && continue
    for pat in $TARGETS; do
      [[ -n "$pat" && "$args" == *"$pat"* ]] && { print -r -- "$pid	$args"; break; }
    done
  done
}

# Recheck ownership, start time and command before each signal. Exclude ancestors.
identity() { ps -p "$1" -o uid=,lstart=,args= 2>/dev/null; }
safe_target() {
  local pid=$1 ancestor=$$ pat current owner
  [[ "$pid" == <-> ]] && (( pid > 1 )) || return 1
  while (( ancestor > 1 )); do
    [[ "$pid" == "$ancestor" ]] && return 1
    ancestor=$(ps -p "$ancestor" -o ppid= 2>/dev/null | tr -d ' ')
    [[ "$ancestor" == <-> ]] || break
  done
  owner=$(ps -p "$pid" -o uid= 2>/dev/null | tr -d ' ')
  [[ "$owner" == "$(id -u)" ]] || return 1
  current=$(ps -p "$pid" -o args= 2>/dev/null)
  [[ "$current" == *memguard* ]] && return 1
  for pat in "${TARGETS[@]}"; do [[ -n "$pat" && "$current" == *"$pat"* ]] && return 0; done
  return 1
}

# ---------- core ----------
typeset -g LAST_WARN=0 LAST_CRIT=0
step() {
  if ! measure; then log 'ERROR measurement unavailable; no process signals sent'; return 0; fi
  local now=$(date +%s) crit=0 warn=0
  (( FREE <= CRIT_FREE || SWAPFILES >= CRIT_SWAP )) && crit=1
  (( FREE <= WARN_FREE || SWAPFILES >= WARN_SWAP )) && warn=1
  (( crit || warn )) || return 0
  local top; top=$(top_apps 3)
  if (( crit )) && [[ ! -e "$PAUSE_FILE" ]]; then
    local found; found=$(find_targets)
    if [[ -n "$found" ]]; then
      local pids=() names=() line p before
      local -A identities
      for line in ${(f)found}; do
        p=${line%%$'\t'*}
        safe_target "$p" || continue
        before=$(identity "$p"); [[ -n "$before" ]] || continue
        [[ ! -e "$PAUSE_FILE" && "$(identity "$p")" == "$before" ]] || continue
        if kill -TERM "$p" 2>/dev/null; then
          pids+=("$p"); identities[$p]=$before; names+=("${${line#*$'\t'}%% *}")
        fi
      done
      (( ${#pids} )) || return 0
      sleep "$GRACE"
      local hard=()
      # Re-evaluate pressure and the pause switch after the grace period.
      if measure && (( FREE <= CRIT_FREE || SWAPFILES >= CRIT_SWAP )) && [[ ! -e "$PAUSE_FILE" ]]; then
        for p in "${pids[@]}"; do
          [[ "$(identity "$p")" == "${identities[$p]}" ]] && safe_target "$p" || continue
          if kill -KILL "$p" 2>/dev/null; then hard+=("$p"); fi
        done
      fi
      log "CRITICAL free=${FREE}% swapfiles=$SWAPFILES term_sent=${(j:,:)pids} kill_sent=${(j:,:)hard} names=${(j:,:)${names:t}} top=[$top]"
      notify "MemGuard: $(t 'stop requested' 'Beenden angefordert')" \
        "$(t "${FREE}% available. Signal sent: ${(j:, :)${names:t}}" "${FREE}% verfügbar. Signal gesendet: ${(j:, :)${names:t}}")"
      LAST_WARN=$now; return 0
    fi
    if (( now - LAST_CRIT > 120 )); then
      log "CRITICAL free=${FREE}% swapfiles=$SWAPFILES no-target top=[$top]"
      notify "MemGuard: $(t 'memory critical' 'Speicher kritisch')" \
        "$(t "Only ${FREE}% free. Largest: $top. Close apps now." "Nur ${FREE}% frei. Größte: $top. Apps jetzt schließen.")"
      LAST_CRIT=$now
    fi
    return 0
  fi
  if (( now - LAST_WARN > WARN_REPEAT )); then
    log "WARN free=${FREE}% swapfiles=$SWAPFILES paused=$([[ -e $PAUSE_FILE ]] && echo yes || echo no) top=[$top]"
    notify "MemGuard: $(t 'memory low' 'Speicher knapp')" \
      "$(t "${FREE}% free, $SWAPFILES swap files. Largest: $top" "${FREE}% frei, $SWAPFILES Swap-Dateien. Größte: $top")"
    LAST_WARN=$now
  fi
}

# ---------- commands ----------
cmd_run() {
  load_cfg || return 1
  local lock_dir="$LOG_DIR/monitor.lock"
  mkdir -p "$LOG_DIR"
  if ! mkdir "$lock_dir" 2>/dev/null; then
    print -u2 "Monitor lock exists: $lock_dir (check for a running instance before removing a stale lock)"; return 1
  fi
  print $$ > "$lock_dir/pid"
  trap 'rm -f "$lock_dir/pid"; rmdir "$lock_dir"' EXIT
  trap 'exit 0' TERM INT HUP
  log "START v$VERSION config=$(cfg_file) warn=${WARN_FREE}% crit=${CRIT_FREE}% targets=${(j:|:)TARGETS}"
  local n=0
  while true; do
    step
    sleep $INTERVAL
    (( ++n % 30 == 0 )) && { load_cfg || return 1; }
  done
}
cmd_status() {
  load_cfg || return 1
  SWAPFILES=unknown
  measure || print -u2 'Measurement unavailable; no healthy state inferred'
  print "MemGuard $VERSION"
  print "  config:      $(cfg_file || true)"
  print "  free memory: ${FREE}%   (warn <= $WARN_FREE, critical <= $CRIT_FREE)"
  print "  swap files:  $SWAPFILES   (warn >= $WARN_SWAP, critical >= $CRIT_SWAP)"
  print "  paused:      $([[ -e $PAUSE_FILE ]] && echo yes || echo no)"
  print "  largest:     $(top_apps 5)"
  print "  targets:     ${(j:, :)TARGETS:-none (warn only)}"
  local m; m=$(find_targets)
  print "  matching now: ${${m:+$(print -r -- "$m" | cut -c1-90 | tr '\n' ';')}:-none}"
  local agent; agent=$(launchctl print "gui/$(id -u)/tech.farpoint.memguard" 2>/dev/null | awk '/^\tstate =/{print $3; exit}')
  print "  agent:       ${agent:-not loaded}"
  [[ -f "$LOG" ]] && { print "  last log:"; tail -3 "$LOG" | sed 's/^/    /'; }
}
cmd_selftest() {
  load_cfg || return 1
  local test_dir; test_dir=$(mktemp -d)
  LOG_DIR="$test_dir"; LOG="$test_dir/selftest.log"; PAUSE_FILE="$test_dir/pause"
  # Isolate the selftest from real pressure, user pause state and logs.
  measure() { FREE=$MEMGUARD_FAKE_FREE; SWAPFILES=0; }
  local dummy="memgu4rd-selftest-dummy" rc=0
  ( exec -a "$dummy" /bin/sleep 300 ) & local dp=$!
  sleep 1
  NOTIFY=false; GRACE=1; TARGETS=("$dummy")
  MEMGUARD_FAKE_FREE=5; step
  if kill -0 $dp 2>/dev/null; then print "FAIL: dummy target still running"; kill $dp; rc=1
  else print "OK   critical + target  -> target terminated"; fi
  TARGETS=(); LAST_CRIT=0; step
  if grep -q 'no-target' "$LOG"; then print 'OK   critical, no target -> warning only'; else rc=1; fi
  MEMGUARD_FAKE_FREE=$WARN_FREE; LAST_WARN=0; step
  if grep -q WARN "$LOG"; then print 'OK   low memory -> warning'; else rc=1; fi
  local before; before=$(wc -l < "$LOG")
  MEMGUARD_FAKE_FREE=100; step
  if [[ "$(wc -l < "$LOG")" == "$before" ]]; then print 'OK   normal -> nothing'; else rc=1; fi
  print "test log: $LOG"
  return $rc
}
case "${1:-status}" in
  run) cmd_run ;;
  once) load_cfg && step ;;
  status) cmd_status ;;
  pause) touch "$PAUSE_FILE"; print "paused: MemGuard keeps measuring but will not terminate anything" ;;
  resume) rm -f "$PAUSE_FILE"; print "resumed" ;;
  selftest) cmd_selftest ;;
  log) tail -${2:-30} "$LOG" ;;
  version) print $VERSION ;;
  *) print "usage: memguard [status|pause|resume|selftest|log [n]|version]"; exit 2 ;;
esac
